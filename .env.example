POSTGRES_USER=jinsei
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jinsei

# Hevy Pro -> App -> Settings -> Developer. Leave empty to disable the sync.
HEVY_API_KEY=
TZ=Europe/Vienna
# The first day of the log: older sessions are never pulled. Empty means all.
HEVY_SYNC_FROM=2026-08-17
# Local time of the daily pull.
HEVY_SYNC_AT=19:30

# aistudio.google.com -> API keys. Leave empty to hide the screenshot import.
# Flash models are the ones covered by the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Web Push. Generate a pair once with `dotnet run --project backend -- vapid`
# and paste both lines here; leave empty to hide notifications entirely.
# The subject identifies this server to the push services and is never shown.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Local times for the two account-wide notifications.
NOTIFY_EVENING_CHECK_AT=21:00
NOTIFY_WEEKLY_REVIEW_AT=20:00
# Local time of the Monday calorie-target update.
ENERGY_RUN_AT=04:30
