POSTGRES_USER=jinsei
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jinsei

# Hevy Pro -> App -> Settings -> Developer. Leave empty to disable the sync.
HEVY_API_KEY=
TZ=Europe/Vienna
# The first day of the log: older sessions are never pulled. Empty means all.
HEVY_SYNC_FROM=2026-08-17
# Local time of the daily pull.
HEVY_SYNC_AT=19:30

# aistudio.google.com -> API keys. Leave empty to hide the screenshot import.
# Flash models are the ones covered by the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
